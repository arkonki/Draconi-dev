{
  "name": "dragonbane-character-manager",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "server": "node --env-file-if-exists=.env server/index.js",
    "mcp": "node --env-file-if-exists=.env server/mcp/index.js",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v",
    "backup": "sh scripts/backup.sh",
    "backup:verify": "sh scripts/verify-backup.sh",
    "restore": "sh scripts/restore.sh",
    "migration:credentials:supabase": "node scripts/build-supabase-credentials.mjs",
    "migration:stage:supabase": "node scripts/build-supabase-staging.mjs",
    "storage:export:supabase": "node scripts/export-supabase-storage.mjs",
    "storage:verify:references": "node scripts/verify-local-image-references.mjs",
    "test:recovery": "node scripts/recovery-smoke.mjs",
    "test:realtime": "node scripts/realtime-smoke.mjs",
    "test:security": "node scripts/security-smoke.mjs",
    "test:user-admin": "node scripts/user-admin-smoke.mjs",
    "test:workflow": "node scripts/workflow-smoke.mjs",
    "test:housekeeping": "node scripts/housekeeping-smoke.mjs",
    "test:helper-api": "node --env-file-if-exists=.env server/helper/smoke.mjs",
    "test:performance": "node --env-file-if-exists=.env server/performance-load.mjs",
    "mcp:measure": "node server/mcp/measure.mjs",
    "test:oauth": "node --env-file-if-exists=.env server/oauth.smoke.mjs",
    "tunnel:start": "bash scripts/tunnel-client.sh start",
    "tunnel:status": "bash scripts/tunnel-client.sh status",
    "tunnel:doctor": "bash scripts/tunnel-client.sh doctor",
    "tunnel:stop": "bash scripts/tunnel-client.sh stop",
    "lint": "eslint . --ext js,mjs,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "npm run typecheck:app && npm run typecheck:node",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.104.0",
    "@uiw/react-md-editor": "^4.1.2",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-feather": "^2.0.10",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.6",
    "read-excel-file": "^9.3.10",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "unist-util-visit": "^5.1.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.8.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true
  }
}
