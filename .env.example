# Docker publishes Postgres, the API and MCP on loopback only by default.
# Set to 0.0.0.0 only if you deliberately expose them (put HTTPS in front first).
# BIND_ADDRESS=127.0.0.1

# Local Docker ports
APP_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL database
POSTGRES_DB=dragonbane
POSTGRES_USER=dragonbane
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Used only when starting the Node API directly on the host. Keep its password
# in sync with POSTGRES_PASSWORD. Docker Compose supplies an internal URL itself.
DATABASE_URL=postgresql://dragonbane:replace-with-a-long-random-password@localhost:5432/dragonbane

# First account, created once when the API starts against an empty database
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# API behavior
SESSION_DAYS=14
# Reduce session-table writes while retaining useful recent-activity timestamps.
SESSION_TOUCH_INTERVAL_SECONDS=300
# Briefly reuse each user's computed campaign/character authorization scope.
AUTH_CONTEXT_CACHE_MS=5000

# PostgreSQL concurrency safeguards and performance telemetry.
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SLOW_QUERY_MS=500
SLOW_REQUEST_MS=500
PERFORMANCE_SAMPLE_SIZE=1024
# Optional overrides for `npm run test:performance`. The rehearsal refuses
# non-loopback targets unless PERF_TEST_ALLOW_REMOTE=true is explicitly set.
# PERF_TEST_USERS=6
# PERF_TEST_DURATION_SECONDS=20
# PERF_TEST_THINK_TIME_MS=125
# PERF_TEST_OUTPUT=/tmp/draconi-performance.json
# PERF_TEST_API=http://localhost:8080/api
# PERF_TEST_MCP_URL=http://localhost:3100/mcp
# PERF_TEST_DATABASE_URL=postgresql://dragonbane:password@localhost:5432/dragonbane
# PERF_TEST_EMAIL=admin@example.com
# PERF_TEST_DEVELOPMENT_TOKEN=replace-with-the-local-development-token
# PERF_TEST_ALLOW_REMOTE=false
# Veebimajutus injects ELKDATA_APP_IP with the current private application IP.
# Do not hardcode it: the provider may change it.
# ELKDATA_APP_IP=
# Optional fallback for direct/local Node startup when ELKDATA_APP_IP is absent.
DRACONI_HOST=0.0.0.0

# Public frontend URL paths. Use / and /api for https://draconi.ee.
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api

# Bounded retention cleanup; set the interval to 0 to disable automatic runs
HOUSEKEEPING_INTERVAL_MINUTES=360
EXPIRED_SESSION_RETENTION_HOURS=24
CHANGE_EVENT_RETENTION_DAYS=14
HOUSEKEEPING_BATCH_SIZE=1000
HOUSEKEEPING_MAX_BATCHES=20

ALLOW_REGISTRATION=false

# Outgoing email: confirms new accounts and sends password-reset links. Leave SMTP_HOST empty to run without email;
# then people cannot reset their own password and accounts need no confirmation. Links in the emails point at
# PUBLIC_BASE_URL, so set that to the address people use in the browser (for example https://draconi.example).
# Public registration (ALLOW_REGISTRATION=true) refuses to start in production without SMTP_HOST and SMTP_FROM.
# Port 587 uses STARTTLS and port 465 uses TLS from the start. Try it with: npm run mail:test -- you@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Dragonbane <no-reply@example.com>"
# Only for a local mail catcher without TLS (such as MailHog); never for a real provider.
# SMTP_REQUIRE_TLS=false
# APP_NAME=Dragonbane Character Manager
# Emails per hour: per target address and per caller address (reset and confirmation requests).
# EMAIL_MAX_REQUESTS_PER_ADDRESS_HOUR=5
# EMAIL_MAX_REQUESTS_PER_IP_HOUR=20
# Failed-login throttling (in-memory, per API process).
# LOGIN_MAX_FAILURES_PER_ACCOUNT=10
# LOGIN_MAX_FAILURES_PER_ADDRESS=30
# LOGIN_RATE_WINDOW_SECONDS=900
# Extra browser origins allowed to call the application API cross-origin
# (comma separated). PUBLIC_BASE_URL is always allowed. OAuth, MCP and /api/v1
# endpoints stay open to any origin because they use bearer tokens only.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=100000000
# Reject raster images whose decoded dimensions exceed this pixel count.
MAX_IMAGE_PIXELS=40000000
MAX_BACKUP_BYTES=1073741824
# The administrator overview warns when the newest backup is older than this many days,
# and flags it as critical past the second value.
# BACKUP_WARN_DAYS=7
# BACKUP_CRITICAL_DAYS=30
# deploy.sh (and the Backup & Restore page) prune old pre-deployment database dumps: the newest
# PREDEPLOY_DUMPS_TO_KEEP are always kept, and so is any dump younger than PREDEPLOY_DUMP_MIN_AGE_DAYS.
# PREDEPLOY_DUMPS_TO_KEEP=10
# PREDEPLOY_DUMP_MIN_AGE_DAYS=14
# The server makes a full recovery set (database and uploads) by itself once a day, at this hour in UTC,
# and keeps the newest AUTO_BACKUP_KEEP of them. Each set is roughly the size of your uploads folder.
# A server that was down at that hour makes the backup shortly after it starts.
# AUTO_BACKUP_ENABLED=true
# AUTO_BACKUP_HOUR_UTC=2
# AUTO_BACKUP_KEEP=7

# Anyone can create a campaign and run it as its GM. This caps how many campaigns one person may own
# (administrators are not limited).
# MAX_OWNED_CAMPAIGNS=10

# Built-in AI (Story Helper and the Solo narrator). Each person adds their own OpenRouter key in Settings, and the
# server stores it encrypted with this secret. Use a long random value (at least 32 characters, for example the
# output of `openssl rand -base64 48`) and keep it out of backups. If you change it, stored keys can no longer be
# read and people have to enter them again.
# AI_KEY_ENCRYPTION_SECRET=

# Dragonbane Helper API and local MCP development authentication
AUTH_MODE=development_token
DEVELOPMENT_TOKEN=replace-with-a-separate-long-random-token
# The token resolves to this existing local user; never accept a user ID from MCP input.
DEVELOPMENT_USER_EMAIL=admin@example.com
HELPER_RATE_LIMIT_PER_MINUTE=120

# Public OAuth/MCP endpoint. Production must use its canonical HTTPS origin.
PUBLIC_BASE_URL=http://localhost:3000
OAUTH_ACCESS_TOKEN_MINUTES=60
OAUTH_REFRESH_TOKEN_DAYS=30
# Internal loopback URL used by the integrated MCP transport. Docker Compose
# supplies http://api:3000 automatically.
MCP_INTERNAL_API_BASE_URL=http://localhost:3000

# MCP uses Streamable HTTP at http://localhost:3100/mcp
MCP_PORT=3100
DRACONI_MCP_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
