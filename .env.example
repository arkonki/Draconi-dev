# Local Docker ports
APP_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL database
POSTGRES_DB=dragonbane
POSTGRES_USER=dragonbane
POSTGRES_PASSWORD=replace-with-a-long-random-password

# First account, created once when the API starts against an empty database
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# API behavior
SESSION_DAYS=14
# Optional bind override. Production hosting may inject ELKDATA_APP_IP instead.
DRACONI_HOST=0.0.0.0

# Public frontend URL paths. Use / and /api for https://draconi.ee.
VITE_BASE_PATH=/
VITE_API_BASE_URL=/api

# Bounded retention cleanup; set the interval to 0 to disable automatic runs
HOUSEKEEPING_INTERVAL_MINUTES=360
EXPIRED_SESSION_RETENTION_HOURS=24
CHANGE_EVENT_RETENTION_DAYS=14
HOUSEKEEPING_BATCH_SIZE=1000
HOUSEKEEPING_MAX_BATCHES=20

ALLOW_REGISTRATION=false
MAX_UPLOAD_BYTES=25000000
MAX_BACKUP_BYTES=1073741824
