# Local Docker ports
APP_PORT=8080
API_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL database
POSTGRES_DB=dragonbane
POSTGRES_USER=dragonbane
POSTGRES_PASSWORD=replace-with-a-long-random-password

# First account, created once when the API starts against an empty database
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# API behavior
SESSION_DAYS=14
ALLOW_REGISTRATION=false
MAX_UPLOAD_BYTES=25000000
MAX_BACKUP_BYTES=1073741824
